{
  "name": "RepoFind",
  "id": "com.github.ahjdzx.repofind",
  "version": "0.1.1",
  "build": 2,
  "icon": {
    "macos": "icon-macos.png",
    "windows": "icon-full.png",
    "linux": "icon-full.png",
    "web": "icon-full.png"
  },
  "capabilities": {
    "fs": { "read": ["${homeDir}", "${dataDir}"], "write": ["${dataDir}"] },
    "network": { "hosts": ["*"] },
    "clipboard": true,
    "statusBar": true,
    "openUrl": { "schemes": ["https"] }
  }
}
